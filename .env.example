# Optional local settings for the CodeAlpha FAQ Chatbot.
# Copy this file to ".env" and adjust if needed. Never commit real secrets.

# Port used by `python app.py` (default: 5001)
PORT=5001

# The app binds to 127.0.0.1 by default. Set HOST=0.0.0.0 only on a trusted network.
# HOST=127.0.0.1

# Werkzeug debugger is OFF by default. Enable only for local development.
# FLASK_DEBUG=1
